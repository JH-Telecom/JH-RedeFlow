{
  "manifest_version": 3,
  "name": "JH RedeFlow – Coletor OFS",
  "version": "1.9.0",
  "description": "Exporta as atividades do OFS e envia ao JH RedeFlow. No WhatsApp Web: identifica quem enviou cada mensagem, temas, privacidade, agendar mensagem e respostas rápidas.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://alloha.fs.ocs.oraclecloud.com/*",
    "https://auto.alloha.com/*",
    "https://jh-redeflow-api.onrender.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp/wa-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp/carregando.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp/wa.js",
        "whatsapp/temas.js",
        "whatsapp-identificador.js"
      ],
      "css": [
        "whatsapp/wa.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jh-rede.vercel.app/*",
        "http://localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "sistema-ponte.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
